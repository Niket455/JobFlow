CAREERPILOT_ENVIRONMENT=local
CAREERPILOT_LOG_LEVEL=INFO
CAREERPILOT_DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@localhost:5432/careerpilot
CAREERPILOT_REDIS_URL=redis://localhost:6379/0
CAREERPILOT_CORS_ORIGINS=http://localhost:3000
CAREERPILOT_JWT_SECRET_KEY=change-me-to-a-random-32-byte-string
CAREERPILOT_MASTER_KEY=E4vHUnDMy5_jzV639cZBKAJuCoxLLH1XVMjKS8wfC1s=
CAREERPILOT_S3_ENDPOINT_URL=http://localhost:9090
CAREERPILOT_S3_ACCESS_KEY=minioadmin
CAREERPILOT_S3_SECRET_KEY=minioadmin
CAREERPILOT_S3_BUCKET=careerpilot

# Outbound fetch for user-URL job ingestion.
CAREERPILOT_USER_AGENT=CareerPilotBot/0.1 (+https://careerpilot.local)
CAREERPILOT_FETCH_TIMEOUT_SECONDS=15
CAREERPILOT_ROBOTS_CACHE_TTL_SECONDS=3600
CAREERPILOT_ENABLE_USER_URL_INGESTION=true
# Greenhouse/Lever/Ashby public-API adapters, selected from the pasted URL.
CAREERPILOT_ENABLE_ATS_INGESTION=true

# Email notifications. Default provider only logs; set to "smtp" to actually send.
CAREERPILOT_EMAIL_PROVIDER=console
CAREERPILOT_EMAIL_ENABLED=true
CAREERPILOT_EMAIL_FROM=no-reply@careerpilot.local
CAREERPILOT_SMTP_HOST=localhost
CAREERPILOT_SMTP_PORT=587
# CAREERPILOT_SMTP_USERNAME=
# CAREERPILOT_SMTP_PASSWORD=
CAREERPILOT_SMTP_USE_TLS=true

# Scheduled alerts (Celery beat).
CAREERPILOT_ALERT_RUN_INTERVAL_MINUTES=15
CAREERPILOT_ALERTS_BATCH_SIZE=100

# Analytics: minimum segment size before a rate is reported.
CAREERPILOT_ANALYTICS_MIN_SAMPLE=5

# LLM gateway: "mock" needs no key (used for local dev/tests); "openai" needs a key.
CAREERPILOT_LLM_PROVIDER=mock
# CAREERPILOT_LLM_PROVIDER=openai
# CAREERPILOT_OPENAI_API_KEY=sk-...
